//- 页脚
footer#footer
  .footer-inner
    .copyright
      if theme.copyright
        != theme.copyright
      else
        | &copy; #{new Date().getFullYear()} #{config.author || config.title}
    
    .footer-info
      p Powered by 
        a(href="https://hexo.io", target="_blank") Hexo
      if theme.icp
        p ICP备案号: #{theme.icp}
